# Copy to .env (same directory as docker-compose.yml) before running `docker-compose up`.
# This file is gitignored — never commit real secrets.

# --- Required ---
POSTGRES_PASSWORD=
CLICKHOUSE_PASSWORD=
JWT_SECRET=
# Generate strong values, e.g.:
#   JWT_SECRET:          openssl rand -base64 48
#   INGEST_API_KEY:      openssl rand -hex 32
#   POSTGRES_PASSWORD:   openssl rand -base64 24
#   CLICKHOUSE_PASSWORD: openssl rand -base64 24
INGEST_API_KEY=

# Retention window (days) for high-volume log data in ClickHouse (events table TTL).
EVENTS_RETENTION_DAYS=90
# Real origin(s) of your frontend, comma-separated. Never "*" in production.
CORS_ORIGIN=https://siem.example.com

# Public URL agents/install scripts should use to reach this SIEM (defaults to request host if unset)
SIEM_PUBLIC_URL=

# Synthetic event/alert generator for demos — writes fake rows into the same events/alerts
# tables real agent-ingested data uses. OFF by default under docker-compose (NODE_ENV=production).
# Only set this to true for a sales/demo instance, never for a real monitoring deployment.
DEMO_MODE=false

# --- Optional: SOAR connectors (each is no-op/"not configured" until its keys are set) ---
SLACK_WEBHOOK_URL=
TEAMS_WEBHOOK_URL=
JIRA_BASE_URL=
JIRA_EMAIL=
JIRA_API_TOKEN=
JIRA_PROJECT_KEY=
SERVICENOW_INSTANCE=
SERVICENOW_USER=
SERVICENOW_PASS=
MISP_BASE_URL=
MISP_API_KEY=
PANOS_HOST=
PANOS_API_KEY=
PANOS_BLOCK_GROUP=K3-Blocked-IPs
CROWDSTRIKE_BASE_URL=
CROWDSTRIKE_CLIENT_ID=
CROWDSTRIKE_CLIENT_SECRET=
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
ALERT_EMAIL_FROM=
ALERT_EMAIL_TO=

# --- Optional: threat intel feed sync + OSINT (each is no-op until its key is set) ---
# Read by the go-service container (OSINT lookups + the offline analyzer's feed cache).
VIRUSTOTAL_API_KEY=
ABUSEIPDB_API_KEY=
SHODAN_API_KEY=
OTX_API_KEY=
PHISHTANK_APP_KEY=
NVD_API_KEY=
# Google Safe Browsing v4 (free API key from Google Cloud Console). Left unset by default
# because Google's no-cost tier ToS restricts it to non-commercial use and caps volume — review
# their current terms before enabling this for anything beyond internal/defensive use.
GOOGLE_SAFE_BROWSING_API_KEY=

# --- Optional: go-service (OSINT/IOC-cache/offline-analyzer) ---
# How often go-service automatically refreshes its threat-intel feed cache. Trigger a manual
# refresh anytime via the analyzer-cli or its HTTP API instead of waiting for this.
FEED_SYNC_INTERVAL_DAYS=30
# Set true to skip the ip-api.com geolocation lookup (air-gapped deployments).
GEOIP_DISABLED=false
